<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>贪吃蛇网页游戏</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#111;display:flex;flex-direction:column;align-items:center;padding-top:20px;color:#fff;font-family:system-ui}
#game{border:3px solid #444;background:#000}
.info{margin-bottom:10px;font-size:18px}
</style>
</head>
<body>
<div class="info">分数：<span id="score">0</span></div>
<canvas id="game" width="400" height="400"></canvas>
<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const scoreDom = document.getElementById('score');
const size = 20;
const count = canvas.width / size;
let snake = [{x:10,y:10}];
let dx = 1, dy = 0;
let food = {};
let score = 0;
let over = false;

function randomFood(){
    return {
        x:Math.floor(Math.random()*count),
        y:Math.floor(Math.random()*count)
    }
}
food = randomFood();

document.addEventListener('keydown',e=>{
    if(over) return;
    if(e.key==='ArrowUp'&&dy!==1){dx=0;dy=-1}
    if(e.key==='ArrowDown'&&dy!==-1){dx=0;dy=1}
    if(e.key==='ArrowLeft'&&dx!==1){dx=-1;dy=0}
    if(e.key==='ArrowRight'&&dx!==-1){dx=1;dy=0}
})

function draw(){
    if(over){
        ctx.fillStyle="#f33";
        ctx.font="30px sans-serif";
        ctx.textAlign="center";
        ctx.fillText("游戏结束",200,200);
        return;
    }
    //清屏
    ctx.fillStyle="#000";
    ctx.fillRect(0,0,400,400);
    //蛇
    ctx.fillStyle="#0f0";
    snake.forEach(p=>{
        ctx.fillRect(p.x*size,p.y*size,size-2,size-2);
    })
    //食物
    ctx.fillStyle="#f00";
    ctx.fillRect(food.x*size,food.y*size,size-2,size-2);

    //新头
    const head = {x:snake[0].x+dx,y:snake[0].y+dy};
    //撞墙
    if(head.x<0||head.y<0||head.x>=count||head.y>=count) over=true;
    //撞自己
    for(let i of snake){
        if(i.x===head.x&&i.y===head.y) over=true;
    }
    snake.unshift(head);
    //吃到食物
    if(head.x===food.x&&head.y===food.y){
        score+=10;
        scoreDom.textContent=score;
        food=randomFood();
    }else{
        snake.pop();
    }
}
setInterval(draw,120);
</script>
</body>
</html>


